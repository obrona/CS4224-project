SELECT
  o.order_id,
  o.order_status,
  o.total_amount,
  o.created_at,
  oi.product_id,
  oi.quantity,
  oi.unit_price
FROM orders AS o
JOIN order_items AS oi
  ON oi.order_id = o.order_id
 AND oi.merchant_id = o.merchant_id
WHERE o.merchant_id = (1)::bigint
  AND o.customer_id = (740001)::bigint
ORDER BY o.created_at DESC
