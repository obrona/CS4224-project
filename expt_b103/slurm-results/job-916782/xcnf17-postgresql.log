	  RETURNING i.product_id
	),
	reservation_ok AS MATERIALIZED (
	  SELECT e.ok
	     AND (SELECT COUNT(*) FROM reserved)
	       = (SELECT COUNT(*) FROM requirements) AS ok
	  FROM eligible e
	),
	inserted_order AS (
	  INSERT INTO orders(
	    order_id, merchant_id, customer_id, order_status, total_amount, created_at
	  )
	  SELECT
