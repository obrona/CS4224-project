	    (3, (474058)::bigint, (5)::integer),
	    (4, (353058)::bigint, (4)::integer),
	    (5, (456058)::bigint, (5)::integer)
	),
	requested_items AS MATERIALIZED (
	  SELECT item_no, product_id, quantity
	  FROM input_items
	  WHERE item_no <= (3)::integer
