	    (873)::bigint,
	    (719873)::bigint,
	    'PENDING'::text,
	    SUM(ri.quantity * p.price)::numeric(12,2),
	    CURRENT_TIMESTAMP
	  FROM requested_items ri
	  JOIN products p
	    ON p.merchant_id = (873)::bigint
