	  )
	  SELECT
	    nextval('benchmark_order_id_seq'),
	    (54)::bigint,
	    (76054)::bigint,
	    'PENDING'::text,
	    SUM(ri.quantity * p.price)::numeric(12,2),
	    CURRENT_TIMESTAMP
	  FROM requested_items ri
	  JOIN products p
	    ON p.merchant_id = (54)::bigint
