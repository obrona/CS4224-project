	  )
	  SELECT
	    nextval('benchmark_order_id_seq'),
	    (40)::bigint,
	    (395040)::bigint,
	    'PENDING'::text,
	    SUM(ri.quantity * p.price)::numeric(12,2),
	    CURRENT_TIMESTAMP
	  FROM requested_items ri
	  JOIN products p
	    ON p.merchant_id = (40)::bigint
