  SELECT array_agg(product_id ORDER BY product_id) AS p
  FROM (
    SELECT product_id FROM products
    WHERE merchant_id = (1)::bigint
    ORDER BY product_id
    LIMIT 5
  ) AS first_products
) AS ids
