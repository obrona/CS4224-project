	  SELECT
	    nextval('benchmark_order_item_id_seq'),
	    (59)::bigint,
	    o.order_id,
	    ri.product_id,
	    ri.quantity,
	    p.price
	  FROM requested_items ri
	  JOIN products p
	    ON p.merchant_id = (59)::bigint
