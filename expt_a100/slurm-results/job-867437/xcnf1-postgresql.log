	  )
	  SELECT
	    nextval('benchmark_order_id_seq'),
	    (21)::bigint,
	    (57021)::bigint,
	    'PENDING'::text,
	    SUM(ri.quantity * p.price)::numeric(12,2),
	    CURRENT_TIMESTAMP
	  FROM requested_items ri
	  JOIN products p
	    ON p.merchant_id = (21)::bigint
	   AND p.product_id = ri.product_id
	  CROSS JOIN reservation_ok ro
	  WHERE ro.ok
	  HAVING COUNT(*) = (4)::integer
	  RETURNING order_id
	),
	inserted_items AS (
