2026-09-20 18:36:04.454 +08 [2851813] STATEMENT:  WITH
	input_items(item_no, product_id, quantity) AS (
	  VALUES
	    (1, (182042)::bigint, (4)::integer),
	    (2, (278042)::bigint, (4)::integer),
	    (3, (124042)::bigint, (2)::integer),
	    (4, (55042)::bigint, (3)::integer),
	    (5, (460042)::bigint, (5)::integer)
	),
	requested_items AS MATERIALIZED (
	  SELECT item_no, product_id, quantity
	  FROM input_items
	  WHERE item_no <= (4)::integer
	),
	-- Duplicate selections need their combined quantity reserved atomically.
	requirements AS MATERIALIZED (
	  SELECT product_id, SUM(quantity)::integer AS quantity
	  FROM requested_items
	  GROUP BY product_id
	),
	-- only eligible if all items requested exist.
	eligible AS MATERIALIZED (
	  SELECT
	    EXISTS (
	      SELECT 1
	      FROM customers c
	      WHERE c.merchant_id = (42)::bigint
	        AND c.customer_id = (219042)::bigint
	    )
	    AND NOT EXISTS (
	      SELECT 1
