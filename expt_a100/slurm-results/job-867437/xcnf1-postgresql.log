2026-09-20 18:39:27.852 +08 [2851929] STATEMENT:  WITH
	input_items(item_no, product_id, quantity) AS (
	  VALUES
	    (1, (99039)::bigint, (2)::integer),
	    (2, (475039)::bigint, (1)::integer),
	    (3, (31039)::bigint, (4)::integer),
	    (4, (353039)::bigint, (3)::integer),
	    (5, (393039)::bigint, (1)::integer)
	),
	requested_items AS MATERIALIZED (
	  SELECT item_no, product_id, quantity
	  FROM input_items
	  WHERE item_no <= (5)::integer
	),
	-- Duplicate selections need their combined quantity reserved atomically.
	requirements AS MATERIALIZED (
	  SELECT product_id, SUM(quantity)::integer AS quantity
	  FROM requested_items
	  GROUP BY product_id
	),
	-- only eligible if all items requested exist.
	eligible AS MATERIALIZED (
	  SELECT
	    EXISTS (
	      SELECT 1
	      FROM customers c
	      WHERE c.merchant_id = (39)::bigint
	        AND c.customer_id = (290039)::bigint
	    )
	    AND NOT EXISTS (
	      SELECT 1
	      FROM requirements r
	      LEFT JOIN products p
	        ON p.merchant_id = (39)::bigint
	       AND p.product_id = r.product_id
	      LEFT JOIN inventory i
	        ON i.merchant_id = (39)::bigint
	       AND i.product_id = r.product_id
	      WHERE p.product_id IS NULL
	         OR i.product_id IS NULL
	         OR i.quantity < r.quantity
	    ) AS ok
	),
	reserved AS (
	  UPDATE inventory i
	  SET quantity = i.quantity - r.quantity,
	      updated_at = CURRENT_TIMESTAMP
	  FROM requirements r, eligible e
	  WHERE e.ok
	    AND i.merchant_id = (39)::bigint
	    AND i.product_id = r.product_id
	  RETURNING i.product_id
	),
	reservation_ok AS MATERIALIZED (
	  SELECT e.ok
	     AND (SELECT COUNT(*) FROM reserved)
	       = (SELECT COUNT(*) FROM requirements) AS ok
	  FROM eligible e
	),
	inserted_order AS (
	  INSERT INTO orders(
	    order_id, merchant_id, customer_id, order_status, total_amount, created_at
	  )
	  SELECT
	    nextval('benchmark_order_id_seq'),
	    (39)::bigint,
	    (290039)::bigint,
	    'PENDING'::text,
	    SUM(ri.quantity * p.price)::numeric(12,2),
	    CURRENT_TIMESTAMP
	  FROM requested_items ri
	  JOIN products p
