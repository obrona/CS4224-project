	      SELECT 1
	      FROM customers c
	      WHERE c.merchant_id = (14)::bigint
	        AND c.customer_id = (654014)::bigint
	    )
	    AND NOT EXISTS (
	      SELECT 1
	      FROM requirements r
	      LEFT JOIN products p
	        ON p.merchant_id = (14)::bigint
	       AND p.product_id = r.product_id
