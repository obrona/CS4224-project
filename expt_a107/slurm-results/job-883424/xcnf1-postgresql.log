	input_items(item_no, product_id, quantity) AS (
	  VALUES
	    (1, (14309)::bigint, (1)::integer),
	    (2, (426309)::bigint, (1)::integer),
	    (3, (259309)::bigint, (4)::integer),
	    (4, (336309)::bigint, (4)::integer),
