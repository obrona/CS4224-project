	FROM orders
	WHERE created_at >= CURRENT_TIMESTAMP - (30)::integer * INTERVAL '1 day'
	  AND created_at < CURRENT_TIMESTAMP
	GROUP BY merchant_id
	ORDER BY revenue DESC
	LIMIT 20;
