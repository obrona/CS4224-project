	    (58)::bigint,
	    (160058)::bigint,
	    'PENDING'::text,
	    SUM(ri.quantity * p.price)::numeric(12,2),
	    CURRENT_TIMESTAMP
	  FROM requested_items ri
	  JOIN products p
	    ON p.merchant_id = (58)::bigint
	   AND p.product_id = ri.product_id
	  CROSS JOIN reservation_ok ro
	  WHERE ro.ok
	  HAVING COUNT(*) = (3)::integer
	  RETURNING order_id
	),
	inserted_items AS (
	  INSERT INTO order_items(
	    order_item_id, merchant_id, order_id, product_id, quantity, unit_price
	  )
	  SELECT
	    nextval('benchmark_order_item_id_seq'),
	    (58)::bigint,
	    o.order_id,
	    ri.product_id,
	    ri.quantity,
	    p.price
	  FROM requested_items ri
	  JOIN products p
	    ON p.merchant_id = (58)::bigint
	   AND p.product_id = ri.product_id
	  CROSS JOIN inserted_order o
	  RETURNING 1
	)
	SELECT
