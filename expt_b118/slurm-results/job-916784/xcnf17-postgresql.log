	  FROM requested_items
	  GROUP BY product_id
	),
	-- only eligible if all items requested exist.
	eligible AS MATERIALIZED (
	  SELECT
	    EXISTS (
	      SELECT 1
	      FROM customers c
	      WHERE c.merchant_id = (17)::bigint
	        AND c.customer_id = (502017)::bigint
	    )
	    AND NOT EXISTS (
	      SELECT 1
	      FROM requirements r
	      LEFT JOIN products p
	        ON p.merchant_id = (17)::bigint
	       AND p.product_id = r.product_id
	      LEFT JOIN inventory i
	        ON i.merchant_id = (17)::bigint
	       AND i.product_id = r.product_id
	      WHERE p.product_id IS NULL
	         OR i.product_id IS NULL
	         OR i.quantity < r.quantity
	    ) AS ok
	),
	reserved AS (
