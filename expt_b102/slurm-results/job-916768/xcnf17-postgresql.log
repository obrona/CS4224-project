	    (89)::bigint,
	    o.order_id,
	    ri.product_id,
	    ri.quantity,
	    p.price
	  FROM requested_items ri
	  JOIN products p
	    ON p.merchant_id = (89)::bigint
	   AND p.product_id = ri.product_id
	  CROSS JOIN inserted_order o
	  RETURNING 1
	)
