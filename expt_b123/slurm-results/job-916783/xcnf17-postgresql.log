	  (SELECT COUNT(*) FROM inserted_items) AS items_created,
	  COALESCE((SELECT order_id FROM inserted_order), 0) AS new_order_id,
	  COALESCE((SELECT total_amount FROM inserted_order), 0) AS new_order_total,
