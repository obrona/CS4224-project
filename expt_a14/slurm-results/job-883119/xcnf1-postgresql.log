	    o.order_id,
	    ri.product_id,
	    ri.quantity,
	    p.price
	  FROM requested_items ri
	  JOIN products p
	    ON p.merchant_id = (474)::bigint
	   AND p.product_id = ri.product_id
	  CROSS JOIN inserted_order o
