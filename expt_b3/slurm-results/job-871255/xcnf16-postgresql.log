	),
	inserted_order AS (
	  INSERT INTO orders(
	    order_id, merchant_id, customer_id, order_status, total_amount, created_at
	  )
	  SELECT
	    nextval('benchmark_order_id_seq'),
	    (23)::bigint,
	    (553023)::bigint,
	    'PENDING'::text,
	    SUM(ri.quantity * p.price)::numeric(12,2),
	    CURRENT_TIMESTAMP
	  FROM requested_items ri
	  JOIN products p
	    ON p.merchant_id = (23)::bigint
	   AND p.product_id = ri.product_id
	  CROSS JOIN reservation_ok ro
	  WHERE ro.ok
	  HAVING COUNT(*) = (5)::integer
	  RETURNING order_id
	),
	inserted_items AS (
