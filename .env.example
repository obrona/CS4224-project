# Local submit profile. Copy to .env and fill it in; .env is gitignored.
#
#   cp .env.example .env
#   $EDITOR .env
#   source .env && sbatch --mail-user="$NOTIFY_EMAIL" expt_a0/run.sh
#
# Every value must be exported. sbatch propagates the submitting environment
# into the job (--export=ALL by default), but a sourced-but-unexported shell
# variable never reaches it.

# Project team number assigned by the course (1-20).
# run.sh derives PGPORT = 5432 + TEAM_ID. It must be unique per team: the
# compute nodes are shared, so a wrong value can collide with another team.
export TEAM_ID=

# Address for Slurm BEGIN/END/FAIL notifications, passed to sbatch as
# --mail-user. A #SBATCH directive cannot read this -- sbatch parses those
# lines as literal text before any shell runs. Left unset, Slurm silently
# defaults to the shared group account cs04@comp.nus.edu.sg.
export NOTIFY_EMAIL=
