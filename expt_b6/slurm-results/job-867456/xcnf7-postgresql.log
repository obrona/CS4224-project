2026-09-20 18:06:00.922 +08 [2197280] STATEMENT:  WITH
	input_items(item_no, product_id, quantity) AS (
	  VALUES
	    (1, (179805)::bigint, (5)::integer),
	    (2, (454805)::bigint, (3)::integer),
	    (3, (17805)::bigint, (2)::integer),
	    (4, (48805)::bigint, (1)::integer),
	    (5, (34805)::bigint, (4)::integer)
	),
	requested_items AS MATERIALIZED (
	  SELECT item_no, product_id, quantity
	  FROM input_items
	  WHERE item_no <= (1)::integer
	),
	-- Duplicate selections need their combined quantity reserved atomically.
	requirements AS MATERIALIZED (
	  SELECT product_id, SUM(quantity)::integer AS quantity
	  FROM requested_items
	  GROUP BY product_id
	),
	-- only eligible if all items requested exist.
	eligible AS MATERIALIZED (
	  SELECT
	    EXISTS (
	      SELECT 1
	      FROM customers c
	      WHERE c.merchant_id = (805)::bigint
	        AND c.customer_id = (6805)::bigint
	    )
	    AND NOT EXISTS (
	      SELECT 1
	      FROM requirements r
	      LEFT JOIN products p
	        ON p.merchant_id = (805)::bigint
	       AND p.product_id = r.product_id
	      LEFT JOIN inventory i
	        ON i.merchant_id = (805)::bigint
	       AND i.product_id = r.product_id
	      WHERE p.product_id IS NULL
	         OR i.product_id IS NULL
	         OR i.quantity < r.quantity
	    ) AS ok
	),
	reserved AS (
	  UPDATE inventory i
	  SET quantity = i.quantity - r.quantity,
	      updated_at = CURRENT_TIMESTAMP
	  FROM requirements r, eligible e
