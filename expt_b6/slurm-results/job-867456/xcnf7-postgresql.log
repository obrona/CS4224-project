	    AND i.merchant_id = (805)::bigint
	    AND i.product_id = r.product_id
	  RETURNING i.product_id
	),
	reservation_ok AS MATERIALIZED (
	  SELECT e.ok
	     AND (SELECT COUNT(*) FROM reserved)
	       = (SELECT COUNT(*) FROM requirements) AS ok
	  FROM eligible e
	),
	inserted_order AS (
