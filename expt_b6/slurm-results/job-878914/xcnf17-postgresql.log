	      WHERE c.merchant_id = (78)::bigint
	        AND c.customer_id = (40078)::bigint
	    )
	    AND NOT EXISTS (
	      SELECT 1
	      FROM requirements r
	      LEFT JOIN products p
	        ON p.merchant_id = (78)::bigint
	       AND p.product_id = r.product_id
