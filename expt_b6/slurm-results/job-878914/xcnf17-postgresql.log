	    (58)::bigint,
	    (783058)::bigint,
	    'PENDING'::text,
	    SUM(ri.quantity * p.price)::numeric(12,2),
	    CURRENT_TIMESTAMP
	  FROM requested_items ri
	  JOIN products p
	    ON p.merchant_id = (58)::bigint
	   AND p.product_id = ri.product_id
	  CROSS JOIN reservation_ok ro
	  WHERE ro.ok
	  HAVING COUNT(*) = (2)::integer
	  RETURNING order_id, total_amount
	),
	inserted_items AS (
