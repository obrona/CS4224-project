	   AND p.product_id = ri.product_id
	  CROSS JOIN reservation_ok ro
	  WHERE ro.ok
	  HAVING COUNT(*) = (4)::integer
	  RETURNING order_id, total_amount
	),
	inserted_items AS (
	  INSERT INTO order_items(
	    order_item_id, merchant_id, order_id, product_id, quantity, unit_price
	  )
	  SELECT
