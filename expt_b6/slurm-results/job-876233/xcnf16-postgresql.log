	  )
	  SELECT
	    nextval('benchmark_order_item_id_seq'),
	    (774)::bigint,
	    o.order_id,
	    ri.product_id,
	    ri.quantity,
	    p.price
	  FROM requested_items ri
	  JOIN products p
