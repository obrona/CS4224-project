2026-09-24 00:34:15.626 +08 [568421] STATEMENT:  WITH
	input_items(item_no, product_id, quantity) AS (
	  VALUES
	    (1, (200805)::bigint, (1)::integer),
	    (2, (143805)::bigint, (2)::integer),
	    (3, (296805)::bigint, (3)::integer),
	    (4, (126805)::bigint, (1)::integer),
	    (5, (436805)::bigint, (1)::integer)
	),
	requested_items AS MATERIALIZED (
	  SELECT item_no, product_id, quantity
	  FROM input_items
	  WHERE item_no <= (3)::integer
	),
	-- Duplicate selections need their combined quantity reserved atomically.
	requirements AS MATERIALIZED (
	  SELECT product_id, SUM(quantity)::integer AS quantity
	  FROM requested_items
	  GROUP BY product_id
	),
	-- only eligible if all items requested exist.
	eligible AS MATERIALIZED (
	  SELECT
	    EXISTS (
	      SELECT 1
	      FROM customers c
	      WHERE c.merchant_id = (805)::bigint
	        AND c.customer_id = (195805)::bigint
	    )
	    AND NOT EXISTS (
	      SELECT 1
	      FROM requirements r
	      LEFT JOIN products p
	        ON p.merchant_id = (805)::bigint
	       AND p.product_id = r.product_id
	      LEFT JOIN inventory i
	        ON i.merchant_id = (805)::bigint
	       AND i.product_id = r.product_id
	      WHERE p.product_id IS NULL
	         OR i.product_id IS NULL
	         OR i.quantity < r.quantity
	    ) AS ok
	),
	reserved AS (
	  UPDATE inventory i
	  SET quantity = i.quantity - r.quantity,
	      updated_at = CURRENT_TIMESTAMP
	  FROM requirements r, eligible e
	  WHERE e.ok
	    AND i.merchant_id = (805)::bigint
	    AND i.product_id = r.product_id
	  RETURNING i.product_id
	),
	reservation_ok AS MATERIALIZED (
	  SELECT e.ok
	     AND (SELECT COUNT(*) FROM reserved)
	       = (SELECT COUNT(*) FROM requirements) AS ok
	  FROM eligible e
	),
	inserted_order AS (
	  INSERT INTO orders(
	    order_id, merchant_id, customer_id, order_status, total_amount, created_at
	  )
	  SELECT
	    nextval('benchmark_order_id_seq'),
	    (805)::bigint,
	    (195805)::bigint,
	    'PENDING'::text,
	    SUM(ri.quantity * p.price)::numeric(12,2),
	    CURRENT_TIMESTAMP
	  FROM requested_items ri
	  JOIN products p
	    ON p.merchant_id = (805)::bigint
	   AND p.product_id = ri.product_id
	  CROSS JOIN reservation_ok ro
	  WHERE ro.ok
	  HAVING COUNT(*) = (3)::integer
	  RETURNING order_id, total_amount
	),
	inserted_items AS (
	  INSERT INTO order_items(
	    order_item_id, merchant_id, order_id, product_id, quantity, unit_price
	  )
	  SELECT
	    nextval('benchmark_order_item_id_seq'),
	    (805)::bigint,
	    o.order_id,
	    ri.product_id,
	    ri.quantity,
	    p.price
	  FROM requested_items ri
	  JOIN products p
	    ON p.merchant_id = (805)::bigint
	   AND p.product_id = ri.product_id
	  CROSS JOIN inserted_order o
	  RETURNING 1
	)
	SELECT
