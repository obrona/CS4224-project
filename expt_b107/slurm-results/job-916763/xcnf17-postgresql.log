	      WHERE c.merchant_id = (64)::bigint
	        AND c.customer_id = (237064)::bigint
	    )
	    AND NOT EXISTS (
	      SELECT 1
	      FROM requirements r
	      LEFT JOIN products p
	        ON p.merchant_id = (64)::bigint
	       AND p.product_id = r.product_id
	      LEFT JOIN inventory i
	        ON i.merchant_id = (64)::bigint
	       AND i.product_id = r.product_id
	      WHERE p.product_id IS NULL
