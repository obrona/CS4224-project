	    CURRENT_TIMESTAMP
	  FROM requested_items ri
	  JOIN products p
	    ON p.merchant_id = (904)::bigint
	   AND p.product_id = ri.product_id
	  CROSS JOIN reservation_ok ro
	  WHERE ro.ok
	  HAVING COUNT(*) = (4)::integer
	  RETURNING order_id
	),
	inserted_items AS (
