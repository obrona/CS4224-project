==================== T3_order_history.sql
SELECT customer_id
FROM orders
WHERE merchant_id = (1)::bigint
ORDER BY order_id
LIMIT 1
EXPLAIN (ANALYZE, VERBOSE, BUFFERS)
SELECT
  o.order_id,
  o.order_status,
  o.total_amount,
  o.created_at,
  oi.product_id,
  oi.quantity,
  oi.unit_price
FROM orders AS o
JOIN order_items AS oi
  ON oi.order_id = o.order_id
 AND oi.merchant_id = o.merchant_id
WHERE o.merchant_id = (1)::bigint
  AND o.customer_id = (740001)::bigint
