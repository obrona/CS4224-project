	  CROSS JOIN reservation_ok ro
	  WHERE ro.ok
	  HAVING COUNT(*) = (5)::integer
	  RETURNING order_id
	),
	inserted_items AS (
	  INSERT INTO order_items(
	    order_item_id, merchant_id, order_id, product_id, quantity, unit_price
